{
  "name": "form-safe",
  "description": "A browser extension that requests a warning before leaving a page after a form edit.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node --test scripts/*.test.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release:prepare": "bun run compile && bun run test && bun run zip && bun run zip:firefox && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "jszip": "3.10.1",
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  },
  "author": "mikr13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikr13/form-safe.git"
  },
  "homepage": "https://github.com/mikr13/form-safe#readme",
  "bugs": {
    "url": "https://github.com/mikr13/form-safe/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.3"
}
